# ─────────────────────────────────────────────────────────────────────────────
# Premium Video DJ – Environment Variables
# Copy this file to .env and fill in your values.
# .env is listed in .gitignore and should NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
# APP_TITLE=Premium Video DJ
# APP_VERSION=2.0.0
# DEBUG=false
# LOG_LEVEL=INFO        # DEBUG | INFO | WARNING | ERROR

# ── Server ────────────────────────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8045

# ── Lyrics API (RapidAPI / Musixmatch) ────────────────────────────────────────
# Required for lyrics fallback when YouTube Music doesn't have them.
# Get your key at https://rapidapi.com/
RAPIDAPI_KEY=your_rapidapi_key_here
# RAPIDAPI_HOST=spotify-web-api3.p.rapidapi.com

# ── WLED (optional) ───────────────────────────────────────────────────────────
# Set to a WLED controller's IP to drive its effect speed from the YouTube
# heatmap of whatever is currently playing. Leave unset to disable.
# WLED_IP=192.168.1.12
# WLED_SX_MIN=40
# WLED_SX_MAX=255
# WLED_GAMMA=1.0
# WLED_RATE=1.0
# WLED_DEADBAND=15
